{
  "name": "StarForge + StarNet Mobile Workspace",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",
  "forwardPorts": [
    8787,
    8799
  ],
  "portsAttributes": {
    "8787": {
      "label": "StarNet full mobile UI",
      "protocol": "http",
      "onAutoForward": "openBrowser"
    },
    "8799": {
      "label": "StarForge Android 9 Test Lab",
      "protocol": "http",
      "onAutoForward": "ignore"
    }
  },
  "postCreateCommand": "npm ci",
  "postStartCommand": "nohup npm start >/tmp/starnet.log 2>&1 &"
}
